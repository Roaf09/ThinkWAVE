# ThinkWAVE server config — copy to .env and fill in real values.
# NEVER commit .env (it holds secrets). This file must contain placeholders only.
#
#   cp .env.example .env
#
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=development
PORT=4000

# Comma-separated allowlist. First entry is canonical (used for email links).
# Local dev:                    CLIENT_ORIGIN=http://localhost:5173
# Dev + production frontend:    CLIENT_ORIGIN=http://localhost:5173,https://your-frontend.onrender.com
CLIENT_ORIGIN=http://localhost:5173

# Required. Must be a long random string (>= 32 chars). Server refuses to boot
# in production without it.
JWT_SECRET=change_me_to_a_long_random_string

# Session token lifetime (jsonwebtoken format: 8h, 30m, 7d). Defaults to 8h.
JWT_EXPIRES_IN=8h

# Required only for first-time SUPERADMIN setup. Same generation as JWT_SECRET.
BOOTSTRAP_SECRET=change_me_to_another_long_random_string

# Local MySQL defaults. Production (Aiven/Render/etc.) must set these
# explicitly — there are no production fallbacks in code on purpose.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=thinkwave
DB_SSL=false
# Path to CA bundle when DB_SSL=true (e.g. Render Secret File or Aiven CA).
DB_SSL_CA_PATH=
# MySQL pool size. A 45-student join burst fans out many queries at once;
# raise on paid DB tiers, keep within your provider's max_connections.
DB_POOL_LIMIT=10

# Mailgun HTTP API (only supported mail provider — no SMTP variables).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Only needed for EU Mailgun accounts; leave unset for the US region.
# MAILGUN_BASE_URL=https://api.eu.mailgun.net
MAILGUN_FROM="ThinkWAVE <no-reply@thinkwave.local>"

# Seconds of grace for teacher reconnect before a live session is swept.
TEACHER_GRACE_SEC=30
