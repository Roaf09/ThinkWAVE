=
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change_me_to_a_long_random_string

# Session token lifetime (jsonwebtoken format: 8h, 30m, 7d). Defaults to 8h.
JWT_EXPIRES_IN=8h
BOOTSTRAP_SECRET=change_me_to_another_long_random_string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=thinkwave
DB_SSL=false
DB_SSL_CA_PATH=
DB_POOL_LIMIT=10

# Mailgun HTTP API (production — Render blocks SMTP ports on some plans).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Only needed for EU Mailgun accounts; leave unset for the US region.
# MAILGUN_BASE_URL=https://api.eu.mailgun.net
MAILGUN_FROM="ThinkWAVE <no-reply@thinkwave.local>"

# Seconds of grace for teacher reconnect before a live session is swept.
TEACHER_GRACE_SEC=30

# Proxy hops in front of Express. Render + Cloudflare = 2 (default). Set 1 for a single reverse proxy, 0 for none.
TRUST_PROXY_HOPS=2

# ---------------------------------------------------------------
# DEPLOY CHECKLIST (read once before going live, revisit yearly)
# 1. FREE RENDER SLEEPS: free web services spin down after ~15 min idle.
#    Sleeping kills in-memory timers + sockets. Either go paid (no sleep)
#    or ping GET /api/health every 10 min (cron-job.org, free). Stuck
#    sessions self-heal at boot via the orphan sweep either way.
# 2. EPHEMERAL DISK: files under uploads/ vanish on every redeploy/restart.
#    Exports are rebuilt on demand (old links 410 + jobs marked FAILED at
#    boot), profile photos live in the DB as compressed dataURLs — nothing
#    permanent sits on disk. Object storage (R2) only matters if you want
#    permanent export links.
# 3. DATABASE PLAN: confirm max_connections and storage cap with your
#    provider (Aiven trials expire — set a calendar reminder). Keep
#    DB_POOL_LIMIT <= max_connections. Watch growth at any time with
#    GET /api/health/detailed (dbSize section): responses/tab_events grow
#    ~1-2k rows per full classroom session; millions of rows are fine
#    with the shipped indexes, but storage caps are real.
# 4. MAIL: Render blocks SMTP ports on some plans — Mailgun (HTTPS) is
#    preferred and tried first. Without any provider, OTP mails only print
#    to the server log (dev) and review mails report emailSent:false.
# 5. TIMEZONE: the pool is pinned to Asia/Manila (+08:00, no DST) to match
#    stored wall-clock datetimes. Do not change without migrating data.
# ---------------------------------------------------------------
